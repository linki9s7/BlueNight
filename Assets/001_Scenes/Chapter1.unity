  promptOffset: {x: 0, y: 2.1}
  dialogues:
  - requiresFlag: c1_haru_sleep
    unlessFlag: 
    setsFlag: 
    lines:
    - speaker: 
      text: "\u2026\u2026\u3059\u3046\u2026\u2026\u3059\u3046\u2026\u2026"
      shadowVoice: 0
  - requiresFlag: c1_captured
    unlessFlag: c1_delivered
    setsFlag: c1_delivered
    lines:
    - speaker: "\u30EB\u30EA"
      text: "\u2026\u2026\u3042\u306E"
      shadowVoice: 0
    - speaker: "\u30EB\u30EA"
      text: "\u5F71\u304C\u8A00\u3063\u3066\u307E\u3057\u305F"
      shadowVoice: 0
    - speaker: "\u30EB\u30EA"
      text: "\u300E\u3042\u308A\u304C\u3068\u3046\u300F\u3063\u3066"
      shadowVoice: 0
    - speaker: "\u30EB\u30EA"
      text: "\u300E\u3042\u306E\u671D\u3001\u8A00\u3048\u306A\u304B\u3063\u305F\u300F"
      shadowVoice: 0
    - speaker: "\u30EB\u30EA"
      text: "\u300E\u5E3D\u5B50\u306E\u3053\u3068\u306A\u3093\u304B\u3001\n\u3069\u3046\u3067\u3082\u3088\u304B\u3063\u305F\u306E\u306B\u300F\u3063\u3066"
      shadowVoice: 0
    - speaker: "\u30CF\u30EB"
      text: "\u2026\u2026\u2026\u2026"
      shadowVoice: 0
    - speaker: "\u30CF\u30EB"
      text: "\u2026\u2026\u3042\u3042\u3002\u305D\u3046\u3060\u3088"
      shadowVoice: 0
    - speaker: "\u30CF\u30EB"
      text: "\u305D\u3046\u3060\u3063\u305F"
      shadowVoice: 0
    - speaker: "\u30CF\u30EB"
      text: "\u3058\u3044\u3055\u3093\u304C\u5165\u9662\u3057\u305F\u671D\u306D"
      shadowVoice: 0
    - speaker: "\u30CF\u30EB"
      text: "\u3042\u305F\u3057\u304C\u8A00\u3063\u305F\u306E\u306F"
      shadowVoice: 0
    - speaker: "\u30CF\u30EB"
      text: "\u300E\u307B\u3089\u3001\u5E3D\u5B50\u304B\u3076\u3063\u3066\u304D\u306A\u300F"
      shadowVoice: 0
    - speaker: "\u30CF\u30EB"
      text: "\u305D\u308C\u304C\u3001\u6700\u5F8C\u3055"
      shadowVoice: 0
    - speaker: "\u30CF\u30EB"
      text: "\u3042\u308A\u304C\u3068\u3046\u306A\u3093\u3066\n\u5B89\u3044\u8A00\u8449\u306A\u306E\u306B\u3055"
      shadowVoice: 0
    - speaker: "\u30CF\u30EB"
      text: "\u3068\u3046\u3068\u3046\u3001\u8A00\u3048\u306A\u304B\u3063\u305F"
      shadowVoice: 0
    - speaker: "\u30CF\u30EB"
      text: "\u3053\u306E\u65E5\u3088\u3051\u3082\u306D"
      shadowVoice: 0
    - speaker: "\u30CF\u30EB"
      text: "\u3042\u306E\u4EBA\u304C\u3001\u3064\u304F\u308D\u3063\u305F\u3093\u3060\u3088"
      shadowVoice: 0
    - speaker: "\u30CF\u30EB"
      text: "\u6BCE\u5E74\u3001\u6625\u306B\u4F55\u3082\u8A00\u308F\u305A\u306B"
      shadowVoice: 0
    - speaker: "\u30CF\u30EB"
      text: "\u2026\u2026\u3042\u308A\u304C\u3068\u306D\u3001\u3042\u3093\u305F"
      shadowVoice: 0
    - speaker: "\u30CF\u30EB"
      text: "\u5E3D\u5B50\u3001\u4F3C\u5408\u3063\u3066\u305F\u3088"
      shadowVoice: 0
  - requiresFlag: c1_talked_haru
    unlessFlag: c1_captured
    setsFlag: 
    lines:
    - speaker: "\u30CF\u30EB"
      text: "\u7121\u7406\u3059\u308B\u3093\u3058\u3083\u306A\u3044\u3088"
      shadowVoice: 0
    - speaker: "\u30CF\u30EB"
      text: "\u2026\u2026\u307B\u3089\u3001\u6C17\u3092\u3064\u3051\u3066"
      shadowVoice: 0
  - requiresFlag: c1_got_lantern
    unlessFlag: 
    setsFlag: c1_talked_haru
    lines:
    - speaker: "\u30CF\u30EB"
      text: "\u304A\u3084\u2026\u2026\u30EB\u30EA\u3061\u3083\u3093\u3058\u3083\u306A\u3044\u304B"
      shadowVoice: 0
    - speaker: "\u30CF\u30EB"
      text: "\u3053\u3093\u306A\u6642\u9593\u306B\u3001\u3069\u3046\u3057\u305F\u3093\u3060\u3044"
      shadowVoice: 0
    - speaker: "\u30EB\u30EA"
      text: "\u2026\u2026\u7720\u308C\u306A\u304F\u3066"
      shadowVoice: 0
    - speaker: "\u30CF\u30EB"
      text: "\u3042\u305F\u3057\u3082\u3060\u3088"
      shadowVoice: 0
    - speaker: "\u30CF\u30EB"
      text: "\u5E74\u5BC4\u308A\u306F\u7720\u308C\u306A\u3044\u3082\u3093\u3060\u3051\u3069"
      shadowVoice: 0
    - speaker: "\u30CF\u30EB"
      text: "\u4ECA\u591C\u306F\u307E\u305F\u3001\u7279\u5225\u3067\u306D"
      shadowVoice: 0
    - speaker: "\u30CF\u30EB"
      text: "\u3042\u305F\u3057\u306E\u5F71\u304C\u3044\u306A\u304F\u306A\u3063\u305F"
      shadowVoice: 0
    - speaker: "\u30CF\u30EB"
      text: "\u3042\u3063\u3061\u306E\u8DEF\u5730\u3078\u3001\u3059\u3046\u3063\u3068"
      shadowVoice: 0
    - speaker: "\u30CD\u30E0"
      text: "\u307B\u3089\u306D"
      shadowVoice: 0
    - speaker: "\u30CF\u30EB"
      text: "\u306A\u3093\u3060\u3044\u3001\u305D\u306E\u866B\u3002\n\u2026\u2026\u307E\u3042\u3001\u3044\u3044\u3084"
      shadowVoice: 0
    - speaker: "\u30CF\u30EB"
      text: "\u6700\u8FD1\u306E\u5B50\u306F\u5909\u308F\u3063\u305F\u3082\u3093\n\u9023\u308C\u3066\u308B\u306D"
      shadowVoice: 0
    - speaker: "\u30CF\u30EB"
      text: "\u30DF\u30AA\u3061\u3083\u3093\u306F\uFF1F"
      shadowVoice: 0
    - speaker: "\u30CF\u30EB"
      text: "\u3042\u3093\u305F\u305F\u3061\u3001\u3044\u3064\u3082\u4E8C\u4EBA\n\u3060\u3063\u305F\u3058\u3083\u306A\u3044\u304B"
      shadowVoice: 0
    - speaker: "\u30CF\u30EB"
      text: "\u30E9\u30E0\u30CD\u3001\u4E8C\u672C\u305A\u3064"
      shadowVoice: 0
    - speaker: "\u30EB\u30EA"
      text: "\u2026\u2026\u2026\u2026"
      shadowVoice: 0
    - speaker: "\u30CF\u30EB"
      text: "\u3042\u3042\u3001\u305D\u3046\u304B\u3002\u660E\u65E5\u3060\u3063\u305F\u306D"
      shadowVoice: 0
    - speaker: "\u30CF\u30EB"
      text: "\u2026\u2026\u3054\u3081\u3093\u3088"
