      face: grandma_normal
    - speaker: "\u30CF\u30EB"
      text: "\u3042\u306E\u4EBA\u304C\u3001\u3064\u304F\u308D\u3063\u305F\u3093\u3060\u3088"
      shadowVoice: 0
      face: grandma_normal
    - speaker: "\u30CF\u30EB"
