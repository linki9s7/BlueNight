      face: grandma_smile
    - speaker: "\u30CF\u30EB"
      text: "\u30DF\u30AA\u3061\u3083\u3093\u306F\uFF1F"
      shadowVoice: 0
      face: grandma_normal
    - speaker: "\u30CF\u30EB"
      text: "\u3042\u3093\u305F\u305F\u3061\u3001\u3044\u3064\u3082\u4E8C\u4EBA\n\u3060\u3063\u305F\u3058\u3083\u306A\u3044\u304B"
