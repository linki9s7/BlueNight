    lines:
    - speaker: "\u30CF\u30EB"
      text: "\u304A\u3084\u2026\u2026\u30EB\u30EA\u3061\u3083\u3093\u3058\u3083\u306A\u3044\u304B"
      shadowVoice: 0
      face: grandma_smile
    - speaker: "\u30CF\u30EB"
      text: "\u3053\u3093\u306A\u6642\u9593\u306B\u3001\u3069\u3046\u3057\u305F\u3093\u3060\u3044"
      shadowVoice: 0
      face: grandma_normal
    - speaker: "\u30EB\u30EA"
      text: "\u2026\u2026\u7720\u308C\u306A\u304F\u3066"
      shadowVoice: 0
      face: ruri_normal
    - speaker: "\u30CF\u30EB"
      text: "\u3042\u305F\u3057\u3082\u3060\u3088"
      shadowVoice: 0
      face: grandma_normal
    - speaker: "\u30CF\u30EB"
      text: "\u5E74\u5BC4\u308A\u306F\u7720\u308C\u306A\u3044\u3082\u3093\u3060\u3051\u3069"
      shadowVoice: 0
      face: grandma_normal
    - speaker: "\u30CF\u30EB"
      text: "\u4ECA\u591C\u306F\u307E\u305F\u3001\u7279\u5225\u3067\u306D"
      shadowVoice: 0
      face: grandma_normal
    - speaker: "\u30CF\u30EB"
      text: "\u3042\u305F\u3057\u306E\u5F71\u304C\u3044\u306A\u304F\u306A\u3063\u305F"
      shadowVoice: 0
      face: grandma_normal
    - speaker: "\u30CF\u30EB"
      text: "\u3042\u3063\u3061\u306E\u8DEF\u5730\u3078\u3001\u3059\u3046\u3063\u3068"
      shadowVoice: 0
      face: grandma_normal
    - speaker: "\u30CD\u30E0"
      text: "\u307B\u3089\u306D"
      shadowVoice: 0
      face: nemu_normal
    - speaker: "\u30CF\u30EB"
      text: "\u306A\u3093\u3060\u3044\u3001\u305D\u306E\u866B\u3002\n\u2026\u2026\u307E\u3042\u3001\u3044\u3044\u3084"
      shadowVoice: 0
      face: grandma_normal
    - speaker: "\u30CF\u30EB"
      text: "\u6700\u8FD1\u306E\u5B50\u306F\u5909\u308F\u3063\u305F\u3082\u3093\n\u9023\u308C\u3066\u308B\u306D"
