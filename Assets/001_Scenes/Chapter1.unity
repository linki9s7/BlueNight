      shadowVoice: 0
      face: ruri_normal
    - speaker: "\u30EB\u30EA"
      text: "\u300E\u3042\u306E\u671D\u3001\u8A00\u3048\u306A\u304B\u3063\u305F\u300F"
      shadowVoice: 0
      face: ruri_normal
    - speaker: "\u30EB\u30EA"
      text: "\u300E\u5E3D\u5B50\u306E\u3053\u3068\u306A\u3093\u304B\u3001\n\u3069\u3046\u3067\u3082\u3088\u304B\u3063\u305F\u306E\u306B\u300F\u3063\u3066"
