  lines:
  - speaker: "\u30CD\u30E0"
    text: "\u306D\u3048\u30EB\u30EA\u3001\u3042\u306E\u8DEF\u5730\u2026\u2026\u306A\u306B\u304B\u9ED2\u3044\u3082\u306E\u304C\u52D5\u3044\u3066\u308B\u3002"
