--- !u!114 &2088469822
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2088469820}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: be80d38dd6cd6ba4e8078da9999e6039, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  range: 1.4
  promptOffset: {x: 0, y: 2}
  dialogues:
  - requiresFlag: m1_shadow_returned
    unlessFlag: 
    setsFlag: 
    lines:
    - speaker: "\u304A\u3070\u3042\u3055\u3093"
      text: "\u2026\u2026\u3059\u3046\u2026\u2026\u3059\u3046\u2026\u2026"
      shadowVoice: 0
  - requiresFlag: m1_shadow_captured
    unlessFlag: 
    setsFlag: m1_shadow_returned
    lines:
    - speaker: "\u304A\u3070\u3042\u3055\u3093"
      text: "\u307E\u3042\u2026\u2026\u305D\u308C\u306F\u3001\u3042\u305F\u3057\u306E\u5F71\u304B\u3044\u3002"
      shadowVoice: 0
    - speaker: "\u30EB\u30EA"
      text: "\u3053\u306E\u5F71\u304C\u2026\u2026\u300E\u3042\u308A\u304C\u3068\u3046\u300F\u3063\u3066\u3002"
      shadowVoice: 0
    - speaker: "\u30EB\u30EA"
      text: "\u3060\u308C\u304B\u306B\u3001\u305A\u3063\u3068\u8A00\u3048\u306A\u304B\u3063\u305F\u307F\u305F\u3044\u3067\u3059\u3002"
      shadowVoice: 0
    - speaker: "\u304A\u3070\u3042\u3055\u3093"
      text: "\u2026\u2026\u305D\u3046\u304B\u3044\u3002\u3058\u3044\u3055\u3093\u306B\u3001\u3061\u3083\u3093\u3068\u8A00\u3048\u305A\u3058\u307E\u3044\u3060\u3063\u305F\u304B\u3089\u306D\u3048\u3002"
      shadowVoice: 0
    - speaker: "\u304A\u3070\u3042\u3055\u3093"
      text: "\u3042\u308A\u304C\u3068\u3046\u3002\u2026\u2026\u3042\u308A\u304C\u3068\u3046\u306D\u3002\u306A\u3093\u3060\u304B\u3001\u3072\u3055\u3057\u3076\u308A\u306B\u7720\u304F\u306A\u3063\u3066\u304D\u305F\u3088\u3002"
      shadowVoice: 0
    - speaker: "\u30CD\u30E0"
      text: "\u5F71\u304C\u3001\u5E30\u3063\u3066\u3044\u304F\u2026\u2026\u3002"
      shadowVoice: 0
    - speaker: 
      text: "M1 \u30D7\u30ED\u30C8\u30BF\u30A4\u30D7\u306F\u3053\u3053\u307E\u3067\u3067\u3059\u3002\u904A\u3093\u3067\u304F\u308C\u3066\u3042\u308A\u304C\u3068\u3046\uFF01"
      shadowVoice: 0
  - requiresFlag: 
    unlessFlag: 
    setsFlag: m1_talked_grandma
    lines:
    - speaker: "\u304A\u3070\u3042\u3055\u3093"
      text: "\u304A\u3084\u2026\u2026\u3053\u3093\u306A\u591C\u3075\u3051\u306B\u3001\u3069\u3046\u3057\u305F\u3093\u3060\u3044\u3002"
      shadowVoice: 0
    - speaker: "\u304A\u3070\u3042\u3055\u3093"
      text: "\u3042\u305F\u3057\u306E\u5F71\u304C\u306D\u3001\u3044\u306A\u304F\u306A\u3063\u3066\u3057\u307E\u3063\u305F\u3093\u3060\u3088\u3002"
      shadowVoice: 0
    - speaker: "\u304A\u3070\u3042\u3055\u3093"
