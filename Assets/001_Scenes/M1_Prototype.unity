  - speaker: "\u30CD\u30E0"
    text: "\u8DEF\u5730\u306E\u89D2\u306B\u3042\u308B\u300E\u30E9\u30F3\u30BF\u30F3\u639B\u3051\u300F\u306B\u30E9\u30F3\u30BF\u30F3\u3092\u639B\u3051\u308C\u3070\u3001\u305D\u3053\u306F\u305A\u3063\u3068\u660E\u308B\u3044\u307E\u307E\u3002\u9003\u3052\u9053\u3092\u3075\u3055\u3052\u308B\u3088\u3002"
